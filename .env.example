# Server-only. Copy to .env.local. Nothing here is exposed to the browser.
HELIUS_API_KEY=
# Optional: developers.jup.ag/portal key; keyless is 5 requests per 10 s, Free key 10, Developer 100
JUPITER_API_KEY=
# This module's share of the 10 s window: 8 on a Free key, 80 on Developer
JUPITER_WINDOW_CALLS=8
# Optional: Pyth Pro (Terminal demo or Starter) key; the label renders without it
PYTH_PRO_API_KEY=
# Fee wallet public key (owner of the USDC fee account); the private key never touches the server
FEE_WALLET=9HgFCQ5Wyn3GcFgsx41F1MXJUbmq1Yf3NwEFk5zUg6Kf
FEE_BPS=10
# Tessera referral code owned by FEE_WALLET (uppercase), empty until created
TESSERA_REFERRAL_CODE=
# Public RPC for the browser ConnectionProvider only (balance reads); sends go through /api/send
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
# Hostnames that serve the app at the root, comma separated; empty means single host (landing at /, app at /companies)
APP_HOSTS=
# Absolute URL of the app for the landing Launch App button; empty falls back to /companies
NEXT_PUBLIC_APP_URL=
# Absolute URL of the deployed site, used for metadata image URLs; empty falls back to https://par-dun.vercel.app
NEXT_PUBLIC_SITE_URL=
